# EditorConfig — Dayflow HRMS
# https://editorconfig.org

root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python source files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# Odoo XML views, data, security, manifest
[*.xml]
indent_style = space
indent_size = 4

# CSV (ir.model.access.csv, record rules, etc.)
[*.csv]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# JSON (manifest, package files)
[*.json]
indent_style = space
indent_size = 4

# YAML (CI, Docker, config)
[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

# Makefile (must use tabs)
[Makefile]
indent_style = tab
