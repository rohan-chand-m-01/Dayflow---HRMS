# .env.example — Dayflow HRMS
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=dayflow_dev
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── Odoo ─────────────────────────────────────────────────────────────────────
ODOO_PORT=8069

# ── Odoo admin master password (used when creating/dropping databases) ────────
# Set a strong random value; never leave blank in real usage.
ODOO_MASTER_PASSWORD=
